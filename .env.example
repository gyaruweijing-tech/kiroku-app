# このファイルをコピーして .env.local を作り、値を埋める（.env.local はコミットしない）
# ローカル開発では全部空でもOK（Basic認証もGitHub同期も自動で無効になる）

# --- Basic認証（アプリ全体に鍵をかける） ---
# 一度ログインするとCookie（90日）が発行され、以降は入力不要。
# パスワードを変えると全端末のCookieが自動で無効になる。
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# --- GitHubをDB代わりに使うための設定 ---
# Fine-grained PAT。対象リポジトリをkirokuだけに絞り、
# Permissions > Contents を "Read and write" にする
GITHUB_TOKEN=
GITHUB_OWNER=gyaruweijing-tech
GITHUB_REPO=kiroku
# 省略時は data/kiroku-data.json / main ブランチ
GITHUB_DATA_PATH=data/kiroku-data.json
GITHUB_BRANCH=main
